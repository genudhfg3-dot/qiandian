{
  "name": "personal-knowledge-base",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "node scripts/devElectron.mjs",
    "build": "tsc -b && vite build && node scripts/buildElectron.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3 -w active-win",
    "preview": "vite preview",
    "verify:repository": "node scripts/verifyKnowledgeRepository.mjs",
    "verify:sqlite": "node scripts/runElectronNode.mjs scripts/verifySqliteRepository.mjs",
    "verify:clipboard": "node scripts/verifyClipboardMarkdown.mjs",
    "verify:assistant": "node scripts/verifyAssistant.mjs",
    "verify:assistant-desktop": "node scripts/verifyAssistantDesktop.mjs",
    "benchmark:assistant": "node scripts/benchmarkAssistant.mjs",
    "package:win": "node scripts/packageWin.mjs",
    "verify:package": "node scripts/verifyPackagingConfig.mjs && npm run verify:first-start",
    "clean:release": "node scripts/cleanRelease.mjs",
    "verify:first-start": "node scripts/runElectronNode.mjs scripts/verifyFirstStartup.mjs",
    "verify:release": "node scripts/verifyReleaseStructure.mjs",
    "verify:ai": "node scripts/runElectronNode.mjs scripts/verifyAiMetadata.mjs",
    "verify:title": "node scripts/runElectronNode.mjs scripts/verifyTitleProtection.mjs",
    "verify:tables": "node scripts/verifyTableSupport.mjs"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
